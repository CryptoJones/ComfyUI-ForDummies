# Sample environment file for an optional auth layer in front of Image Studio.
# The plain webui.py has NO authentication — if you expose it beyond a trusted
# LAN, put an auth wrapper/proxy in front and give it credentials like these.
# Copy to ~/.config/flux-webui.env, fill in real values, chmod 600, and point
# EnvironmentFile= in comfyui-webui.service at it. Never commit the real file.
FLUX_USERNAME=changeme
FLUX_PASSWORD=changeme
FLUX_SESSION_SECRET=changeme
